        <element xsi:type="archimate:ApplicationComponent" name="Source Control and CI/CD (GitLab CE)" id="id-756d6d5db6834df39357a89ae9f5d2be">
          <documentation>Git repositories, merge requests and CI pipelines; system of record for SQL models, DAGs, schemas and policies; promotes versions from test to production.</documentation>
          <property key="SAF-ID" value="SAF-AC23"/>
          <property key="Product" value="GitLab CE"/>
          <property key="License" value="MIT"/>
          <property key="TOGAF-Phase" value="C - Application"/>
        </element>
      </folder>
