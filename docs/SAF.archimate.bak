  <folder name="Technology &amp; Physical" id="id-2218e4fd5bac412da385368f418df585" type="technology">
    <folder name="Phase D - Technology Architecture" id="id-a0481253142c47408a33998410544879">
      <folder name="Nodes" id="id-d392dd70dea3451eb0596ba74373f0eb">
        <element xsi:type="archimate:Node" name="Kubernetes Platform Cluster" id="id-d84b8e06ec2d49f0b7b6faaba0778c5f">
          <documentation>Container platform hosting all application components; on-premise or hybrid, with separate namespaces for production, test and research (secure) workloads.</documentation>
          <property key="SAF-ID" value="SAF-TN01"/>
          <property key="TOGAF-Phase" value="D - Technology"/>
        </element>
        <element xsi:type="archimate:Node" name="Compute Worker Nodes" id="id-73ddb06ca10b4ba29b804b483815d6ca">
